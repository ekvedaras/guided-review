#!/usr/bin/env bash
# The gate: fmt, clippy, tests. Stops at the first failure.
# Usage: scripts/check [test-filter]   (a filter runs only the matching tests)
set -euo pipefail

cd "$(dirname "$0")/.."

# rustup's cargo before any other: it follows rust-toolchain.toml, which a distro's older cargo cannot build.
if [ -x "$HOME/.cargo/bin/cargo" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
elif ! command -v cargo >/dev/null 2>&1; then
    for toolchain in "$HOME"/.rustup/toolchains/stable-*/bin; do
        export PATH="$toolchain:$PATH"
        break
    done
fi
command -v cargo >/dev/null 2>&1 || { echo "cargo not found" >&2; exit 127; }

echo "== target_os only in src/platform"
if grep -rn 'target_os' --include='*.rs' src tests build.rs | grep -vE '^src/platform(\.rs|/)'; then
    echo "check the OS in src/platform, not here (docs/wiki/platform.md)" >&2
    exit 1
fi
echo "== tests write a fake executable only through support::write_executable"
# Allowed: read_ticks locks and unlocks a folder; release_install sets a mode inside a tar archive it builds in memory.
if grep -rnE 'set_mode\(|from_mode\(|set_permissions\(|OpenOptionsExt' --include='*.rs' tests \
    | grep -vE '^tests/it/support/' \
    | grep -vE '^tests/it/read_ticks\.rs:[0-9]+:\s*std::fs::set_permissions\(&folder, ' \
    | grep -vE '^tests/it/release_install\.rs:[0-9]+:\s*header\.set_mode\(mode\);'; then
    echo "write a fake executable with support::write_executable, it never holds the file open for writing (Text file busy)" >&2
    exit 1
fi
echo "== change notes"
# The base is the open PR's, so a stacked layer is not blamed for the layers below; without one, origin/main.
# "changelog: none" in the PR body passes, as in CI. CHANGES_BASE overrides the base.
if [ -n "${CI:-}" ]; then
    echo "skipped in CI: the change-notes workflow covers it"
else
    changes_base="${CHANGES_BASE:-}"
    if [ -z "$changes_base" ] && command -v gh >/dev/null 2>&1; then
        pr=$(gh pr view --json baseRefName,body 2>/dev/null || true)
        if [ -n "$pr" ]; then
            changes_base="origin/$(printf '%s' "$pr" | jq -r .baseRefName)"
            if printf '%s' "$pr" | jq -r .body | tr -d '\r' | grep -qix 'changelog: none'; then export CHANGELOG_NONE=1; fi
        fi
    fi
    scripts/changes-check "${changes_base:-origin/main}" --worktree
    echo "== tests seen red (a warning only)"
    scripts/red-unrecorded "${changes_base:-origin/main}"
fi
echo "== fmt"
cargo fmt --all -- --check
echo "== clippy, default features (what cargo install builds)"
cargo clippy --all-targets -- -D warnings
echo "== clippy, all features"
cargo clippy --all-targets --all-features -- -D warnings
echo "== test"
cargo test --all-features ${1:+"$1"}
echo "ALL GREEN"
