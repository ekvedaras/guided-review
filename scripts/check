#!/usr/bin/env bash
# The gate: fmt, clippy, tests. Stops at the first failure.
# Usage: scripts/check [test-filter]   (a filter runs only the matching tests)
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v cargo >/dev/null 2>&1; then
    export PATH="$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin:$HOME/.cargo/bin:$PATH"
fi
command -v cargo >/dev/null 2>&1 || { echo "cargo not found" >&2; exit 127; }

echo "== fmt"
cargo fmt --all -- --check
echo "== clippy"
cargo clippy --all-targets --all-features -- -D warnings
echo "== test"
cargo test --all-features ${1:+"$1"}
echo "ALL GREEN"
