#!/usr/bin/env bash
# Pictures of the app for looking at the UI, in both appearances: <out>/light/*.png and <out>/dark/*.png.
# Usage: scripts/snapshot <pr-url> [out-dir] [--only <name-start>[,...]] [--light|--dark]
#   (default out-dir: /tmp/guided-review-snapshots). --only 00-top,24 takes just the pictures whose names
#   start so; the app still walks every scene, but skips the wait for the ones it does not take.
# Scenes: NN-top / NN-end of every tour screen, then 20-settings ... 31-shortcuts and on (src/app/layouts/one_step/scenes.rs).
# The PR needs a tour on disk (~/.guided-review/tours); only that tour is copied into the run. Runs the app on a
# throwaway HOME, so the maintainer's running app is left alone, and draws without the display, so a locked
# screen works. Code comes from this repo when the PR is this repo's, else from GitHub.
set -euo pipefail

usage="usage: scripts/snapshot <pr-url> [out-dir] [--only <name-start>[,...]] [--light|--dark]"
positional=()
only=""
appearances=(light dark)
while [ $# -gt 0 ]; do
    case "$1" in
        --only) only="${2:?$usage}"; shift 2 ;;
        --light) appearances=(light); shift ;;
        --dark) appearances=(dark); shift ;;
        *) positional+=("$1"); shift ;;
    esac
done
pr="${positional[0]:?$usage}"
out="${positional[1]:-/tmp/guided-review-snapshots}"

cd "$(dirname "$0")/.."

if ! command -v cargo >/dev/null 2>&1; then
    export PATH="$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin:$HOME/.cargo/bin:$PATH"
fi
command -v cargo >/dev/null 2>&1 || { echo "cargo not found" >&2; exit 127; }

export GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token)}"
cargo build --features snapshots
binary="$PWD/target/debug/guided-review"

tour="$("$binary" tour-path "$pr")"
[ -f "$tour" ] || { echo "no tour at $tour: write one first" >&2; exit 1; }
tours_root="${GUIDED_REVIEW_TOURS_DIR:-$HOME/.guided-review/tours}"
tour_in_root="${tour#"$tours_root"/}"

# A fixed, short path: Settings shows paths under HOME, so they match from run to run, and herdr refuses
# socket paths longer than macOS allows. So one run at a time on the machine: agents in other worktrees
# share the path, and a second run waits for the first instead of wiping its files.
work=/tmp/guided-review-snapshot
lock=/tmp/guided-review-snapshot.lock
until mkdir "$lock" 2>/dev/null; do
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
        rm -rf "$lock"
        continue
    fi
    if [ -z "${waiting:-}" ]; then
        echo "another snapshot run is going (pid ${holder:-?}); waiting for it" >&2
        waiting=1
    fi
    sleep 2
done
echo $$ >"$lock/pid"
trap 'rm -rf "$work" "$lock"' EXIT
rm -rf "$work"
mkdir -p "$work/tours/$(dirname "$tour_in_root")"
cp "$tour" "$work/tours/$tour_in_root"
# The tour's own files, like its summary's pictures, sit in a folder beside it.
if [ -d "${tour%.json}" ]; then
    cp -R "${tour%.json}" "$work/tours/${tour_in_root%.json}"
fi

rm -rf "$out"

# A tiling window manager (AeroSpace) stretches the window to the screen, and the pictures with it, so
# the run's window floats at the size the app opens it with.
float_window_of() {
    command -v aerospace >/dev/null 2>&1 || return 0
    local pid="$1" window=""
    for _ in $(seq 1 40); do
        window="$(aerospace list-windows --all --format '%{window-id}|%{app-pid}' \
            | awk -F'|' -v pid="$pid" '$2 == pid { print $1; exit }')"
        [ -n "$window" ] && break
        sleep 0.25
    done
    [ -n "$window" ] && aerospace layout floating --window-id "$window" || true
}

# One app run per appearance. The run's serve process is the one that was not there before its open,
# so other guided-review processes on the machine do not count.
shoot() {
    local appearance="$1"
    local home="$work/home"
    local pictures="$out/$appearance"
    rm -rf "$home"
    mkdir -p "$home" "$pictures"
    local started=$SECONDS
    local others
    others="$(pgrep -f "$binary serve" || true)"
    HOME="$home" \
        GUIDED_REVIEW_TOURS_DIR="$work/tours" \
        GUIDED_REVIEW_APP_COMMAND="$binary" \
        GUIDED_REVIEW_SNAPSHOTS="$pictures" \
        GUIDED_REVIEW_SNAPSHOT_APPEARANCE="$appearance" \
        GUIDED_REVIEW_SNAPSHOT_ONLY="$only" \
        "$binary" open "$pr"

    local pid=""
    for _ in $(seq 1 120); do
        if [ -S "$home/.guided-review/app.sock" ]; then
            pid="$(pgrep -f "$binary serve" | grep -vxF "${others:-none}" | head -n 1 || true)"
            [ -n "$pid" ] && break
        fi
        sleep 0.5
    done
    [ -n "$pid" ] || { echo "$appearance: the app never started" >&2; return 1; }
    float_window_of "$pid" &

    for _ in $(seq 1 600); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "$appearance: the app did not quit in 10 minutes; stopping it" >&2
        kill "$pid"
        return 1
    fi
    echo "$appearance: $(ls "$pictures" | wc -l | tr -d ' ') pictures in $((SECONDS - started))s"
}

for appearance in "${appearances[@]}"; do
    shoot "$appearance"
done

for png in "$out"/*/*.png; do
    sips -Z 2000 "$png" >/dev/null
done
ls "$out/${appearances[0]}"
