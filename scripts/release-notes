#!/usr/bin/env bash
# Release notes from the change notes in changes/: every note added in the range, grouped by kind,
# then the commit subjects folded away for the maintainer, ending on a compare link.
# Usage: scripts/release-notes <from-tag-or-empty> <to-ref>   (empty from = every note up to <to-ref>)
set -euo pipefail

from="${1-}"
to="${2:?usage: scripts/release-notes <from-tag-or-empty> <to-ref>}"

cd "$(dirname "$0")/.."

repo_url="https://github.com/${GITHUB_REPOSITORY:-ekvedaras/guided-review}"
range="${from:+$from..}$to"

kinds="added changed fixed removed"

kind_heading() {
    case "$1" in
        added) echo "Added" ;;
        changed) echo "Changed" ;;
        fixed) echo "Fixed" ;;
        removed) echo "Removed" ;;
    esac
}

notes=$(scripts/change-notes-in "$from" "$to")

printed_any=false
for kind in $kinds; do
    of_kind=$(printf '%s\n' "$notes" | grep "^changes/$kind-" || true)
    [ -z "$of_kind" ] && continue
    $printed_any && echo
    echo "## $(kind_heading "$kind")"
    echo
    for note in $of_kind; do
        git show "$to:$note" | awk 'NR == 1 { print "- " $0; next } { print "  " $0 }' | sed 's/^  $//'
    done
    printed_any=true
done

$printed_any || echo "No changes users can see."

echo
echo "<details><summary>Commits</summary>"
echo
git log --no-merges --format='- %s (%h)' "$range"
echo
echo "</details>"
echo
if [ -n "$from" ]; then
    echo "**Full changelog**: $repo_url/compare/$from...$to"
else
    echo "**Full changelog**: $repo_url/commits/$to"
fi
