#!/usr/bin/env bash
# Release notes from the change notes in changes/: every note added in the range, grouped by kind,
# each ending on the PR that added it and its author, then the commit subjects folded away for the
# maintainer, ending on a compare link.
# Usage: scripts/release-notes <from-tag-or-empty> <to-ref>   (empty from = every note up to <to-ref>)
set -euo pipefail

from="${1-}"
to="${2:?usage: scripts/release-notes <from-tag-or-empty> <to-ref>}"

cd "$(dirname "$0")/.."

repo="${GITHUB_REPOSITORY:-ekvedaras/guided-review}"
repo_url="https://github.com/$repo"
range="${from:+$from..}$to"

kinds="added changed fixed removed"

kind_heading() {
    case "$1" in
        added) echo "Added" ;;
        changed) echo "Changed" ;;
        fixed) echo "Fixed" ;;
        removed) echo "Removed" ;;
    esac
}

# "(#43 by @login)" for the merged PR that added the note, else "(<sha> by @login)" for its commit.
# Nothing when GitHub cannot be asked, so a preview works offline.
credit() {
    local sha by
    sha=$(git log --diff-filter=A --format=%H -1 "$to" -- "$1")
    if ! by=$(gh api "repos/$repo/commits/$sha/pulls" \
        --jq 'first(.[] | select(.merged_at != null)) | "#\(.number) by @\(.user.login)"' 2>/dev/null); then
        by=""
    fi
    if [ -z "$by" ]; then
        if ! by=$(gh api "repos/$repo/commits/$sha" --jq '.author.login // empty' 2>/dev/null); then
            by=""
        fi
        if [ -n "$by" ]; then by="${sha:0:7} by @$by"; fi
    fi
    if [ -n "$by" ]; then echo " ($by)"; fi
}

notes=$(scripts/change-notes-in "$from" "$to")

printed_any=false
for kind in $kinds; do
    of_kind=$(printf '%s\n' "$notes" | grep "^changes/$kind-" || true)
    [ -z "$of_kind" ] && continue
    $printed_any && echo
    echo "## $(kind_heading "$kind")"
    echo
    for note in $of_kind; do
        git show "$to:$note" | sed -e '/^$/d' -e '$s/$/'"$(credit "$note" | sed 's/[&/\\]/\\&/g')"'/' |
            awk 'NR == 1 { print "- " $0; next } { print "  " $0 }'
    done
    printed_any=true
done

$printed_any || echo "No changes users can see."

echo
echo "<details><summary>Commits</summary>"
echo
git log --no-merges --format='- %s (%h)' "$range"
echo
echo "</details>"
echo
if [ -n "$from" ]; then
    echo "**Full changelog**: $repo_url/compare/$from...$to"
else
    echo "**Full changelog**: $repo_url/commits/$to"
fi
