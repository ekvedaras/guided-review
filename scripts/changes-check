#!/usr/bin/env bash
# Fails when a change to what users get (src/, skills/) adds no note in changes/.
# A PR whose body has a line "changelog: none" passes without one (CHANGELOG_NONE=1).
# Usage: scripts/changes-check <base-ref> [head-ref]
# A head-ref of "--worktree" checks HEAD plus everything on disk, committed or not (what scripts/check runs).
set -euo pipefail

base="${1:?usage: scripts/changes-check <base-ref> [head-ref]}"
head="${2:-HEAD}"

cd "$(dirname "$0")/.."

kinds="added changed fixed removed"

if [ "$head" = "--worktree" ]; then
    index=$(mktemp)
    trap 'rm -f "$index"' EXIT
    export GIT_INDEX_FILE="$index"
    rm -f "$index"
    git add -A
    head=$(git write-tree)
    unset GIT_INDEX_FILE
    fork=$(git merge-base "$base" HEAD)
else
    fork=$(git merge-base "$base" "$head")
fi

added_notes=$(git diff --name-only --diff-filter=A "$fork" "$head" -- changes/ | grep -v '^changes/README.md$' || true)

for note in $added_notes; do
    kind=$(basename "$note" | cut -d- -f1)
    case " $kinds " in
        *" $kind "*) ;;
        *) echo "$note: the name must start with one of: $kinds" >&2; exit 1 ;;
    esac
    [ -f "$note" ] || continue
    words=$(wc -w < "$note")
    lines=$(grep -c . "$note" || true)
    if [ "$words" -gt 20 ] || [ "$lines" -gt 1 ]; then
        echo "$note: a note is one short sentence on one line, at most 20 words (has $words words, $lines lines)." >&2
        exit 1
    fi
done

[ -n "$added_notes" ] && exit 0
[ "${CHANGELOG_NONE:-0}" = "1" ] && exit 0

if git diff --quiet "$fork" "$head" -- src/ skills/; then
    exit 0
fi

echo "This change touches src/ or skills/ but adds no note in changes/." >&2
echo "Add changes/<added|changed|fixed|removed>-<slug>.md (see changes/README.md)," >&2
echo "or put a line 'changelog: none' in the PR body if users see no difference." >&2
exit 1
